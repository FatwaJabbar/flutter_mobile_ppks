upload_certificate.pem

# Flutter metadata
.metadata

# Keystore properties (contains passwords)
key.properties
android/key.properties

# ================= Node.js (scraper harga sawit) =================
# Dependency Node.js -- di-install ulang otomatis oleh GitHub Actions / npm install,
# tidak perlu (dan sebaiknya tidak) ikut ke-commit karena isinya ribuan file pihak ketiga.
node_modules/
scripts/node_modules/

# Env lokal -- kalau kamu test scraper di laptop pakai file .env berisi API key
.env
scripts/.env